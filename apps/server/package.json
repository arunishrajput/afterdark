{
  "name": "@afterdark/server",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "AfterDark authoritative game server (Express + Socket.IO).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx src/sim/cli.ts"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@afterdark/shared": "workspace:*",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  }
}
